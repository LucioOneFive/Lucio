##Sufficiency map for viz how traditional target creation leads to overengineer solutions

import numpy as np
import matplotlib.pyplot as plt

# --- mock relationship: WVTR vs shelf life (saturating curve) ---
wvtr = np.linspace(12, 1, 400)
shelf_life = 30 * (1 - np.exp(-0.35 * (12 - wvtr)))

# --- background "penalty" gradient (qualitative) ---
X, Y = np.meshgrid(wvtr, np.linspace(0, 30, 400))
penalty_gradient = (12 - X)

plt.figure(figsize=(8, 6))

# Background gradient with legend
contour = plt.contourf(
    X, Y, penalty_gradient,
    levels=30, alpha=0.35
)
cbar = plt.colorbar(contour)
cbar.set_label("Relative system penalty\n(costs / design complexity / sustainability)")

# Shelf-life curve (black)
plt.plot(wvtr, shelf_life, color="black", linewidth=2)

# Required shelf life
plt.axhline(24, linewidth=1)
plt.text(11.2, 25.2, "Target shelf-life", va="center", ha="left")

# Vertical specification lines
plt.axvline(7, linestyle="--", color="blue")
plt.axvline(2, linestyle="--", color="red")

# Labels at y = 5, aligned with vertical lines
plt.text(
    7.2, 3,
    "Successfully forecasted\nbarrier need",
    ha="right", va="center"
)

plt.text(
    2.2, 3,
    "Requested\nbarrier",
    ha="right", va="center"
)

# Over-engineering zone shading
plt.fill_betweenx([24, 30], 2, 7, alpha=0.25)

# Over-engineering label (above 24 months, left of WVTR=2)
plt.text(
    2.3, 25.2,
    "Overengineering zone",
    ha="right", va="center"
)

# Axis labels and title
plt.xlabel("WVTR (g/(m²·day) at 38 ºC / 90 RH)")
plt.ylabel("Shelf life (months)")
plt.title("Functional sufficiency map")

# Axis limits (reversed x-axis)
plt.ylim(0, 30)
plt.xlim(12, 1)

plt.tight_layout()

plt.savefig(
    "/Users/Luf1/Downloads/Functional_sufficiency_map.png",
    format="png",
    dpi=600,
    bbox_inches="tight",
    transparent=True
)

plt.show()

plt.show()
